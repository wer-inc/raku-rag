# Phase 0 local-first env template. Copy to `.env` and adjust. NEVER commit a real `.env`.
# (.env is gitignored; .env.example is committed.)

# --- Auth (mock) ---
RAKU_TOKEN_SIGNING_SECRET=dev-secret-change-me
# Local-only helper for the demo UI. Ignored when NODE_ENV=production.
RAKU_ENABLE_DEV_TOKEN_ISSUER=true

# --- Observability / LoggingPolicy (OD-008 / ADR-015) ---
# Raw retrieved context + raw user query are NOT stored by default. Override ONLY for local/dev
# debugging via explicit opt-in. Allowed: disabled | redacted | full_opt_in
RAKU_LOG_RAW_RETRIEVED_CONTEXT=disabled
RAKU_LOG_RAW_USER_QUERY=disabled

# --- Local dependencies (docker compose; infra/docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=raku
POSTGRES_USER=raku
POSTGRES_PASSWORD=raku
DATABASE_URL=postgresql://raku:raku@localhost:5432/raku

# MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=raku-local

# LocalStack SQS
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/raku-ingest
SQS_DLQ_URL=http://localhost:4566/000000000000/raku-ingest-dlq
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Langfuse (local trace sink). Leave LANGFUSE_ENABLED=false to run with a mock/disabled sink.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- API / Web ---
API_PORT=3000
WEB_PORT=3002
ANSWER_SERVICE_URL=http://127.0.0.1:8088
RAKU_CORS_ORIGIN=http://localhost:3002,http://127.0.0.1:3002
